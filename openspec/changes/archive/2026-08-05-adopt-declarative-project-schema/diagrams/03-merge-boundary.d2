# The exact overlay onto a Compose-referenced workload.
#
# The whole point is that the set is closed and additive: three things go in,
# every other field passes through untouched, and a collision stops generation
# rather than winning silently. container_name is deliberately NOT in the
# overlay — an earlier draft had Onebox silently remove it, which discards a
# declaration the user wrote. It is a refusal condition instead.
#
# dagre rather than elk: elk placed the two decision edges on the same side and
# the labels overprinted.
# d2-layout: dagre
direction: down

src: "User-authored Compose service\nreferenced as file#service"

overlay: "Onebox adds exactly three things" {
  a: "proxy.network appended to networks\n(existing entries kept, in order)"
  b: "ob.app · ob.release · ob.workload"
  c: "traefik.* derived per declared route\n(only when a route is declared)"
}

check: "Conflict?\nnetwork_mode set · ingress network already attached\nob.* label · traefik.* label with a route\ncontainer_name with rolling or replicas > 1" {
  shape: diamond
}

fail: "GENERATION FAILS\nnames the key and the file" {
  style.bold: true
}

out: "Generated workload service\nevery other field passes through untouched"

src -> check
overlay -> check
check -> fail: "yes — never overwritten,\nnever silently removed" {
  style.stroke: "#c0392b"
  style.font-color: "#c0392b"
}
check -> out: "no" {
  style.stroke: "#2f9e6b"
  style.font-color: "#2f9e6b"
}
