---
/* Starlight's page footer, plus a colophon.
 *
 * onebox.run was the only LabStack property with no ownership line on it —
 * labstack.com, Goal.fit and Monk.trade all carry one. The wording differs here
 * on purpose: those are closed products and say "All rights reserved", while
 * Onebox is Apache-2.0, and for this audience the licence is the more useful
 * half of the sentence.
 *
 * The year is derived at build time rather than written down, as it is on the
 * other sites, so the notice cannot go stale in a file nobody revisits.
 *
 * Overriding the component means restating the layout it came with: a
 * component override replaces Starlight's scoped styles along with its markup,
 * so the footer and meta rules below are its own, kept as they were. The
 * `credits` kudos link is not carried over — the site does not enable it, and
 * reproducing it would mean importing an icon from inside Starlight's internals
 * to render something that has never appeared.
 *
 * The three parts are imported from `@astrojs/starlight/components/*`, the
 * published path, rather than the `virtual:starlight/components/*` specifiers
 * Starlight's own footer uses: those are typed in a declaration file the site's
 * tsconfig does not see, and `astro check` fails on all three. The difference
 * that buys Starlight is indirection — a `virtual:` import resolves through any
 * override configured for that component. Nothing here overrides the edit link,
 * the last-updated date or the pagination, so this renders the same thing; a
 * future override of one of them would need this file changed to match.
 */
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

const year = new Date().getFullYear();
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <p class="colophon">
    <span>&copy; {year} Onebox by <a href="https://labstack.com">LabStack LLC</a></span>
    <span class="sep" aria-hidden="true">·</span>
    <span>
      <a href="https://github.com/labstack/onebox/blob/main/LICENSE">Apache-2.0</a>
    </span>
  </p>
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }

  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  /* Sits at the same size and colour as the edit link and the last-updated
     date, because it is the same kind of thing: page chrome, not content. */
  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5ch;
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  /* The whole line is 42 characters, and in this face that is a little wider
     than a phone. Left to wrap it broke after "LLC" and started the next line
     with the separator; below this width the two facts are stacked instead and
     the separator, which only exists to divide them on one line, is dropped. */
  @media (max-width: 30rem) {
    .colophon {
      display: block;
    }

    .colophon > span {
      display: block;
    }

    /* Same specificity as the rule above, and after it, so the separator is
       hidden rather than turned into a line of its own. */
    .colophon > .sep {
      display: none;
    }
  }

  .colophon a {
    color: inherit;
    text-decoration: none;
  }

  .colophon a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>
