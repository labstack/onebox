---
/* What you write, beside what Onebox derives from it.
 *
 * The page authors both halves as Markdown — a YAML fence, then a list of the
 * generated names — so the whole comparison survives into `<path>.md`. This
 * component only puts them side by side and frames them.
 *
 * The right half lists generated identity rather than imitating the output of
 * `ob preview` or `ob canonical`. Both of those come from the binary, and a
 * hand-written approximation on the landing page would be the one piece of
 * documentation nothing regenerates — wrong the first time a default moves.
 */
---

<div class="ob-panes"><slot /></div>

<style>
  .ob-panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  @media (min-width: 55rem) {
    .ob-panes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Expressive Code wraps every fence in its own figure, so the frame here is
     the list's alone; the code block already has one that matches the site. */
  .ob-panes :global(> ul) {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
  }

  .ob-panes :global(> ul > li) {
    display: block;
    margin: 0;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }

  .ob-panes :global(> ul > li:first-child) {
    border-top: 0;
  }

  /* Two paragraphs per item, from a loose Markdown list: the generated name,
     then what it is. A two-line row rather than a wrapped one. */
  .ob-panes :global(> ul > li > p) {
    margin: 0;
  }

  .ob-panes :global(> ul > li > p:first-child) {
    margin-bottom: 0.15rem;
  }

  /* Inline code in the descriptions is prose, not a chip: Starlight's default
     bordered pill inside a row this small reads as five more controls. */
  .ob-panes :global(> ul > li code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }

  .ob-panes :global(> ul > li > p:first-child code) {
    background: none;
    padding: 0;
    font-size: 0.76rem;
    color: var(--ob-code);
    overflow-wrap: anywhere;
  }

  .ob-panes :global(> p) {
    grid-column: 1 / -1;
    margin: 0.25rem 0 0;
    font-size: 0.84rem;
    line-height: 1.8;
    color: var(--sl-color-gray-3);
    max-width: 68ch;
  }
</style>
