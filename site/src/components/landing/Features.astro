---
/* The capability grid, from a Markdown list the page authors.
 *
 * Every peer site in this category — Coolify, Dokploy, Depot, Linear — puts a
 * named list of capabilities on the landing page with a mark beside each. This
 * one had philosophy where a reader was looking for a list.
 *
 * The marks are applied by position with CSS masks rather than injected as
 * markup, so they need no script, cost nothing when the list is read as
 * Markdown, and cannot desynchronise from the text at runtime. Reordering the
 * list in the page reorders the marks with it, which is wrong — the mapping is
 * positional. The order is therefore fixed by the page, not by taste, and the
 * count is checked in the comment beside the rules below.
 */
---

<div class="ob-feat" data-ob-figure><slot /></div>

<style>
  .ob-feat :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
  }

  @media (min-width: 34rem) {
    .ob-feat :global(ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .ob-feat :global(ul) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ob-feat :global(li) {
    position: relative;
    margin: 0;
    padding: 0.95rem 1rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--sl-color-gray-3);
  }

  /* Two paragraphs per item, from a loose Markdown list: the capability, then
     what it means. */
  .ob-feat :global(li > p) {
    margin: 0;
  }

  .ob-feat :global(li > p:first-child) {
    margin-bottom: 0.3rem;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  .ob-feat :global(li > p:first-child strong) {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .ob-feat :global(li code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }

  /* The mark. One rule draws it; the twelve below only supply the shape, so a
     thirteenth capability needs one more line rather than a new block. */
  .ob-feat :global(li)::before {
    content: "";
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    margin-bottom: 0.6rem;
    background: var(--ob-code);
    -webkit-mask: var(--ob-mark) center / contain no-repeat;
    mask: var(--ob-mark) center / contain no-repeat;
  }

  /* Twelve capabilities, in the order the page lists them. */
  .ob-feat :global(li:nth-child(1)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><path d='M5 7h14M5 12h9M5 17h11'/></svg>"); }
  .ob-feat :global(li:nth-child(2)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><path d='M4 12a8 8 0 0 1 13-6M20 12a8 8 0 0 1-13 6M17 3v3h-3M7 21v-3h3'/></svg>"); }
  .ob-feat :global(li:nth-child(3)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M9 7l-5 5 5 5M4 12h11a5 5 0 0 1 0 10'/></svg>"); }
  .ob-feat :global(li:nth-child(4)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M5 5v14M10 5l9 7-9 7z'/></svg>"); }
  .ob-feat :global(li:nth-child(5)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><ellipse cx='12' cy='6' rx='8' ry='3'/><path d='M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6'/></svg>"); }
  .ob-feat :global(li:nth-child(6)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3v12M8 11l4 4 4-4M4 19h16'/></svg>"); }
  .ob-feat :global(li:nth-child(7)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><path d='M7 11V8a5 5 0 0 1 10 0v3'/><rect x='5' y='11' width='14' height='10' rx='2'/></svg>"); }
  .ob-feat :global(li:nth-child(8)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linejoin='round'><path d='M12 3l8 4v6c0 5-3.5 7.5-8 8.5C7.5 20.5 4 18 4 13V7z'/></svg>"); }
  .ob-feat :global(li:nth-child(9)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M8 6l-5 6 5 6M16 6l5 6-5 6'/></svg>"); }
  .ob-feat :global(li:nth-child(10)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z'/></svg>"); }
  .ob-feat :global(li:nth-child(11)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><rect x='4' y='5' width='16' height='14' rx='2'/><path d='M8 10h8M8 14h5'/></svg>"); }
  .ob-feat :global(li:nth-child(12)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>"); }
</style>
