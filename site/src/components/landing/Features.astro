---
/* Four capability groups, from a Markdown list the page authors.
 *
 * Every peer site in this category — Coolify, Dokploy, Depot, Linear — puts a
 * named list of capabilities on the landing page with a mark beside each. The
 * groups keep the scan useful without turning the homepage into a reference.
 *
 * The marks are applied by position with CSS masks rather than injected as
 * markup, so they need no script, cost nothing when the list is read as
 * Markdown, and cannot desynchronise from the text at runtime. The mapping is
 * positional, so the order is fixed by the page and the count is checked
 * beside the rules below.
 */
---

<div class="ob-feat" data-ob-figure><slot /></div>

<style>
  .ob-feat :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 44rem) {
    .ob-feat :global(ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ob-feat :global(li) {
    position: relative;
    margin: 0;
    padding: 1.4rem 1.4rem 1.5rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }

  @media (min-width: 44rem) {
    .ob-feat :global(li:nth-child(even)) {
      padding-inline-start: 1.4rem;
      border-inline-start: 1px solid var(--sl-color-gray-5);
    }
  }

  /* Two paragraphs per item, from a loose Markdown list: the capability, then
     what it means. */
  .ob-feat :global(li > p) {
    margin: 0;
  }

  .ob-feat :global(li > p:first-child) {
    margin-bottom: 0.3rem;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  .ob-feat :global(li > p:first-child strong) {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ob-feat :global(li code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }

  /* Four capability groups, each with a simple operational mark. */
  .ob-feat :global(li)::before {
    content: "";
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    margin-bottom: 0.6rem;
    background: var(--ob-code);
    -webkit-mask: var(--ob-mark) center / contain no-repeat;
    mask: var(--ob-mark) center / contain no-repeat;
  }

  /* Four groups, in the order the page lists them. */
  .ob-feat :global(li:nth-child(1)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3l8 4v6c0 5-3.5 7.5-8 8.5C7.5 20.5 4 18 4 13V7z'/><path d='M8.5 12l2.2 2.2 4.8-5'/></svg>"); }
  .ob-feat :global(li:nth-child(2)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><ellipse cx='12' cy='6' rx='8' ry='3'/><path d='M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'/></svg>"); }
  .ob-feat :global(li:nth-child(3)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round'><rect x='5' y='10' width='14' height='10' rx='2'/><path d='M8 10V7a4 4 0 0 1 8 0v3'/></svg>"); }
  .ob-feat :global(li:nth-child(4)) { --ob-mark: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M8 6l-5 6 5 6M16 6l5 6-5 6'/></svg>"); }
</style>
