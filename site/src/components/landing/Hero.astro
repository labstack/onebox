---
/* The landing page's hero, registered as Starlight's `Hero` override.
 *
 * Starlight renders this component instead of a page title whenever a page
 * declares `hero` in its frontmatter. Only the landing page does, so the
 * override is effectively page-scoped — but it is a global registration, and a
 * second splash page with a hero would get this layout too.
 *
 * The headline, tagline and actions stay in frontmatter so the copy is edited
 * where the rest of the site's copy lives. The transcript is here instead,
 * because it is structure: the argument of the page is that a deploy is
 * something you read before it runs, and the hero has to show a real one.
 */
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="ob-hero">
  <div class="ob-hero-copy">
    <h1 id="_top">{title}</h1>
    {tagline && <p class="ob-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="ob-hero-actions">
          {actions.map((action, i) => (
            <a
              href={action.link}
              class={i === 0 ? "ob-action ob-action-primary" : "ob-action"}
              {...action.attrs}
            >
              {action.text}
            </a>
          ))}
        </div>
      )
    }
    <p class="ob-hero-note">
      No agent on the host. SSH with known-host checking, and <code>ob eject</code>{" "}
      hands the generated runtime over permanently — one command, no negotiation.
    </p>
  </div>

  <div class="ob-term" data-ob-transcript aria-label="An example plan, approval and deploy">
    <div class="ob-term-bar">
      <span>plan → approve → deploy</span>
      <span>ob.yml · production</span>
    </div>
    <pre tabindex="0"><code><span class="ln"><b>$</b> ob plan --out ob-plan.json</span>
<span class="ln dim">reading   ob.yml · production · root@203.0.113.10</span>
<span class="ln dim">state     r-0041 serving · no drift</span>
<span class="ln"> </span>
<span class="ln mut">~ shop-web-1       image   1.4.0 → 1.5.0</span>
<span class="ln mut">~ shop-web-2       image   1.4.0 → 1.5.0</span>
<span class="ln add">+ shop-worker-1    new workload</span>
<span class="ln warn">! migrate          pre_release · data effect unknown</span>
<span class="ln"> </span>
<span class="ln dim">plan      sha256:9f21ab4c… · mode 0600 · expires 15m</span>
<span class="ln dim">risk      migration · strong confirmation required</span>
<span class="ln"> </span>
<span class="ln"><b>$</b> ob approve --plan ob-plan.json --out ob-approval.json</span>
<span class="ln dim">type the release id to confirm: <span class="mut">r-0042</span></span>
<span class="ln"> </span>
<span class="ln"><b>$</b> ob deploy --plan ob-plan.json --approval ob-approval.json</span>
<span class="ln dim">staged    r-0042</span>
<span class="ln dim">migrate   provider atlas · 1 revision · changed=true</span>
<span class="ln dim">rolling   shop-web-1 … healthy</span>
<span class="ln dim">rolling   shop-web-2 … healthy</span>
<span class="ln dim">verified  checks/url 200 · X-App-Ready: yes</span>
<span class="ln add">serving   r-0042 · r-0041 superseded<span class="ob-caret"></span></span></code></pre>
  </div>
</div>

<style>
  .ob-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  @media (min-width: 62rem) {
    .ob-hero {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }

  /* The id is Starlight's own — it is what the skip link targets, and
     onebox.css already styles `h1#_top` for every other page. An id selector
     outranks any number of classes, so the landing headline has to be named the
     same way to set its own tracking. */
  .ob-hero-copy h1#_top {
    font-size: clamp(2rem, 4.4vw, 2.85rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 1.1rem;
    color: var(--sl-color-white);
    text-wrap: balance;
    max-width: 16ch;
  }

  .ob-hero-tagline {
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0 0 1.6rem;
    max-width: 46ch;
  }

  .ob-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* The two accent colours are the CTA's whole job. Nothing else on the page
     may use accent-low as a filled surface — that is what keeps one green
     button reading as the single thing to press. */
  .ob-action {
    display: inline-block;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    padding: 0.7rem 1.35rem;
    font-size: 0.85rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .ob-action:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }

  .ob-action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .ob-action-primary {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .ob-action-primary:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ob-action {
      transition:
        border-color 0.15s ease,
        background-color 0.15s ease;
    }
  }

  .ob-hero-note {
    margin: 1.5rem 0 0;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--sl-color-gray-3);
    max-width: 48ch;
  }

  .ob-hero-note code {
    color: var(--sl-color-gray-2);
    background: none;
    padding: 0;
  }

  .ob-term {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    overflow: hidden;
  }

  .ob-term-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  /* The transcript is wider than a phone and scrolls inside its own box, so it
     carries tabindex="0" and a focus ring — the same requirement the reference
     tables meet in onebox.css, for the same reason: an overflow a keyboard
     cannot reach is an overflow a keyboard user cannot read. */
  .ob-term pre {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    background: none;
    border: 0;
  }

  .ob-term pre:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }

  .ob-term code {
    font-size: 0.74rem;
    line-height: 1.95;
    background: none;
    padding: 0;
    color: var(--sl-color-gray-2);
  }

  /* Deliberately not display:block. The spans sit inside a <pre>, so the
     newlines between them in the source are already the line breaks; making
     each span a block as well produced a blank line after every line. */
  .ob-term .ln {
    display: inline;
  }

  /* Set by script only, so a page with JS disabled shows the whole transcript
     rather than an empty box. */
  .ob-term .ln[data-pending] {
    opacity: 0;
  }

  .ob-term b {
    color: var(--ob-code);
    font-weight: 400;
  }

  .ob-term .dim {
    color: var(--sl-color-gray-3);
  }

  .ob-term .mut {
    color: var(--sl-color-gray-2);
  }

  .ob-term .add {
    color: var(--ob-code);
  }

  .ob-term .warn {
    color: var(--ob-warn);
  }

  .ob-caret {
    display: inline-block;
    width: 0.5em;
    height: 0.95em;
    margin-left: 0.15em;
    vertical-align: -0.12em;
    background: var(--ob-code);
    animation: ob-blink 1.05s steps(1) infinite;
  }

  @keyframes ob-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ob-caret {
      animation: none;
    }
  }
</style>

<script>
  /* Reveal the transcript a line at a time once it is on screen.
   *
   * The pacing is the point rather than decoration: the page claims a deploy is
   * something you read before it runs, so the hero makes you read it. Anyone who
   * has asked not to see motion, or who arrives without JS, gets the finished
   * transcript immediately instead.
   */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const term = document.querySelector<HTMLElement>("[data-ob-transcript]");

  if (term && !reduced) {
    const lines = Array.from(term.querySelectorAll<HTMLElement>(".ln"));
    lines.forEach((line) => line.setAttribute("data-pending", ""));

    let started = false;
    const play = () => {
      if (started) return;
      started = true;
      let i = 0;
      const step = () => {
        if (i >= lines.length) return;
        lines[i]?.removeAttribute("data-pending");
        i += 1;
        // Fast enough that the hero is not a blank box on arrival — the whole
        // transcript lands in under two seconds — but still paced, because the
        // point is that a deploy reports itself rather than appearing.
        window.setTimeout(step, i < 10 ? 55 : 90);
      };
      step();
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              play();
              observer.disconnect();
            }
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(term);
    } else {
      play();
    }
  }
</script>
