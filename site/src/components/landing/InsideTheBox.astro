---
/* A cutaway of one host: what Onebox owns once an application is deployed.
 *
 * This is the page's signature figure, and the only one a competitor cannot
 * copy — every name in it is generated identity, published in the project file
 * reference and produced by the binary. It is drawn rather than screenshotted
 * because there is no dashboard to photograph, and drawing it keeps it true.
 *
 * The figure is decorative to a screen reader — the names are in the list the
 * page authors beneath it, which is also what survives into `<path>.md`. The
 * label is on the container rather than the SVG so the two cannot disagree.
 */
---

<figure class="ob-host" data-ob-figure>
  <svg viewBox="0 0 700 300" aria-hidden="true" focusable="false">
    <rect x="1" y="18" width="698" height="264" rx="10" fill="none" stroke="var(--sl-color-gray-5)"></rect>
    <text x="16" y="12" class="t-xs">ONE HOST · ONE APPLICATION</text>

    <text x="22" y="44" class="t-xs">ob-ingress</text>
    <path d="M22 52h656" stroke="var(--sl-color-accent)" stroke-dasharray="4 4" opacity="0.6"></path>

    <rect x="22" y="70" width="140" height="48" rx="8" fill="var(--sl-color-accent-low)" stroke="var(--sl-color-accent)"></rect>
    <text x="36" y="92" class="t-name">onebox-proxy</text>
    <text x="36" y="108" class="t-sm">Traefik · TLS</text>

    <g fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5">
      <path d="M162 94h48"></path>
      <path d="M162 94h24v62h24"></path>
      <path d="M162 94h24v124h24"></path>
    </g>

    <rect x="210" y="70" width="150" height="48" rx="8" fill="var(--sl-color-gray-6)" stroke="var(--sl-color-gray-5)"></rect>
    <text x="224" y="92" class="t-name">shop-web-1</text>
    <text x="224" y="108" class="t-sm">healthy</text>
    <circle cx="344" cy="86" r="3.5" fill="var(--sl-color-accent)"></circle>

    <rect x="210" y="132" width="150" height="48" rx="8" fill="var(--sl-color-gray-6)" stroke="var(--sl-color-gray-5)"></rect>
    <text x="224" y="154" class="t-name">shop-web-2</text>
    <text x="224" y="170" class="t-sm">healthy</text>
    <circle cx="344" cy="148" r="3.5" fill="var(--sl-color-accent)"></circle>

    <rect x="210" y="194" width="150" height="48" rx="8" fill="var(--sl-color-gray-6)" stroke="var(--sl-color-gray-5)"></rect>
    <text x="224" y="216" class="t-name">shop-worker-1</text>
    <text x="224" y="232" class="t-sm">no route</text>

    <text x="386" y="66" class="t-xs">ob_shop</text>
    <g fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5">
      <path d="M360 94h56"></path>
      <path d="M360 156h28v-54h28"></path>
      <path d="M360 218h28v-116h28"></path>
    </g>

    <rect x="416" y="70" width="262" height="76" rx="8" fill="var(--sl-color-gray-6)" stroke="var(--sl-color-accent)"></rect>
    <text x="432" y="92" class="t-name">shop-postgres-1</text>
    <text x="432" y="108" class="t-sm">credential generated on the server</text>
    <text x="432" y="124" class="t-ok">backup → a repository you own</text>
    <text x="432" y="139" class="t-xs">ob_shop_postgres_data</text>

    <rect x="416" y="160" width="262" height="82" rx="8" fill="var(--sl-color-black)" stroke="var(--sl-color-gray-5)"></rect>
    <text x="432" y="182" class="t-xs">ON DISK</text>
    <text x="432" y="202" class="t-name">/var/lib/ob/shop</text>
    <text x="432" y="220" class="t-sm">releases/ · current · journal · services</text>

    <text x="22" y="266" class="t-xs">shop_default — the application's own Compose network</text>
  </svg>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .ob-host {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    padding: 1.1rem;
    overflow: hidden;
  }

  .ob-host svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ob-host text {
    font-family: var(--sl-font-mono);
  }

  .t-name {
    font-size: 12px;
    fill: var(--sl-color-white);
  }

  .t-sm {
    font-size: 10px;
    fill: var(--sl-color-gray-3);
  }

  .t-xs {
    font-size: 10px;
    fill: var(--sl-color-gray-4);
    letter-spacing: 0.1em;
  }

  .t-ok {
    font-size: 10px;
    fill: var(--ob-code);
  }

  .ob-host figcaption {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .ob-host figcaption :global(p) {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--sl-color-gray-3);
  }

  .ob-host figcaption :global(code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }
</style>
