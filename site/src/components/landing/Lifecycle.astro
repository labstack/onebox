---
/* The four commands as a rail, with the two artifacts falling out of the middle
 * two — then the steps themselves.
 *
 * The rail replaces four paragraphs that were describing a sequence. It shows
 * the thing the paragraphs could not: that `ob plan` and `ob approve` each
 * produce a file, and that execution needs both.
 *
 * The figure is decorative to a screen reader because the ordered list beneath
 * it says the same thing in words — and that list is what the page authors,
 * what `<path>.md` serves, and what remains if the SVG never loads.
 */
---

<div class="ob-life" data-ob-figure>
  <!-- Both captions sit above the rail. They were below it, where the two lines
       dropping to the artifacts ran straight through them, and the first one
       ran off the left edge of the viewBox because it was centred on a node
       only 46 units in. Nothing is under the rail now except a connector and
       the file it points at. -->
  <svg class="ob-rail" viewBox="0 0 700 176" aria-hidden="true" focusable="false">
    <path d="M92 78h516" stroke="var(--sl-color-gray-5)" stroke-width="2"></path>

    <text x="92" y="30" class="r-name" text-anchor="middle">ob validate</text>
    <text x="92" y="50" class="r-sm" text-anchor="middle">contacts nothing</text>
    <circle cx="92" cy="78" r="8" fill="var(--sl-color-black)" stroke="var(--sl-color-accent)" stroke-width="2"></circle>

    <text x="264" y="30" class="r-name" text-anchor="middle">ob plan</text>
    <text x="264" y="50" class="r-sm" text-anchor="middle">observes the host</text>
    <circle cx="264" cy="78" r="8" fill="var(--sl-color-black)" stroke="var(--sl-color-accent)" stroke-width="2"></circle>

    <text x="436" y="30" class="r-name" text-anchor="middle">ob approve</text>
    <text x="436" y="50" class="r-sm" text-anchor="middle">binds to that plan</text>
    <circle cx="436" cy="78" r="8" fill="var(--sl-color-black)" stroke="var(--sl-color-accent)" stroke-width="2"></circle>

    <text x="608" y="30" class="r-name" text-anchor="middle">ob deploy</text>
    <text x="608" y="50" class="r-sm" text-anchor="middle">under a lock</text>
    <circle cx="608" cy="78" r="8" fill="var(--sl-color-accent)"></circle>

    <path d="M264 86v20" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5"></path>
    <rect x="209" y="106" width="110" height="26" rx="5" fill="var(--sl-color-accent-low)" stroke="var(--sl-color-accent)"></rect>
    <text x="264" y="123" class="r-file" text-anchor="middle">ob-plan.json</text>

    <path d="M436 86v20" fill="none" stroke="var(--sl-color-gray-5)" stroke-width="1.5"></path>
    <rect x="369" y="106" width="134" height="26" rx="5" fill="var(--sl-color-accent-low)" stroke="var(--sl-color-accent)"></rect>
    <text x="436" y="123" class="r-file" text-anchor="middle">ob-approval.json</text>

    <text x="350" y="164" class="r-sm" text-anchor="middle">both must be present, and both expire</text>
  </svg>

  <div class="ob-steps"><slot /></div>
</div>

<style>
  .ob-life {
    display: grid;
    gap: 1.5rem;
    font-family: var(--ob-font-display);
  }

  .ob-rail {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-gray-6);
    padding: 0.6rem;
  }

  .ob-rail text {
    font-family: var(--sl-font-mono);
  }

  .r-name {
    font-size: 12px;
    fill: var(--sl-color-white);
  }

  .r-sm {
    font-size: 10.5px;
    fill: var(--sl-color-gray-3);
  }

  .r-file {
    font-size: 10.5px;
    fill: var(--sl-color-white);
  }

  .ob-steps :global(ol) {
    list-style: none;
    counter-reset: ob-step;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 44rem) {
    .ob-steps :global(ol) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ob-steps :global(ol > li) {
    counter-increment: ob-step;
    position: relative;
    margin: 0;
    padding: 1rem 1rem 1.05rem 2.8rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--sl-color-gray-3);
  }

  .ob-steps :global(ol > li)::before {
    content: "0" counter(ob-step);
    position: absolute;
    left: 1rem;
    top: 0.95rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-4);
  }

  .ob-steps :global(li > p) {
    margin: 0;
  }

  .ob-steps :global(li > p:first-child) {
    margin-bottom: 0.25rem;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  .ob-steps :global(li > p:first-child code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.78rem;
    color: var(--ob-code);
  }

  .ob-steps :global(li > p:first-child strong) {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ob-steps :global(li code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }
</style>
