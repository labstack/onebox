---
/* Lays the limits out as ruled rows: the limit on the left, what it means on
 * the right. Authored as a Markdown list on the page, for the same reason the
 * refusals are — this is the content an agent reading `<path>.md` most needs to
 * come away with.
 */
---

<div class="ob-limits"><slot /></div>

<style>
  .ob-limits :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .ob-limits :global(li) {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.84rem;
    line-height: 1.8;
    color: var(--sl-color-gray-3);
  }

  @media (min-width: 55rem) {
    .ob-limits :global(li) {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 2rem;
      align-items: baseline;
    }
  }

  /* Two paragraphs per item, from a loose Markdown list: the limit, then what
     it means in practice. They become the two columns. */
  .ob-limits :global(li > p) {
    margin: 0;
  }

  .ob-limits :global(li > p:first-child) {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .ob-limits :global(li > p:first-child strong) {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .ob-limits :global(code) {
    background: none;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }

  .ob-limits :global(> p) {
    margin: 1.25rem 0 0;
    font-size: 0.84rem;
    line-height: 1.8;
    color: var(--sl-color-gray-3);
    max-width: 66ch;
  }
</style>
