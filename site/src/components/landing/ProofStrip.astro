---
/* The strip under the hero: what is true about the project right now.
 *
 * Every comparable site puts social proof here — stars, downloads, customer
 * logos, testimonials. Onebox has none of those yet, and inventing the feeling
 * of them would undercut the one thing the page is actually selling. These are
 * operational facts instead: how it connects, what approval means, the backup
 * boundary, and the licence.
 *
 * Authored as a Markdown list, one item per fact, bold value first.
 */
---

<div class="ob-proof"><slot /></div>

<style>
  .ob-proof :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    border-block: 1px solid var(--sl-color-gray-5);
    font-family: var(--ob-font-display);
  }

  .ob-proof :global(li) {
    margin: 0;
    padding: 1.1rem 1rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--sl-color-gray-3);
  }

  .ob-proof :global(li:first-child) {
    border-inline-start: 0;
  }

  .ob-proof :global(li > p) {
    margin: 0;
  }

  .ob-proof :global(li strong) {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin-bottom: 0.15rem;
  }

  .ob-proof :global(li code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  @media (max-width: 40rem) {
    .ob-proof :global(ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ob-proof :global(li) {
      border-top: 1px solid var(--sl-color-gray-5);
    }

    .ob-proof :global(li:nth-child(-n + 2)) {
      border-top: 0;
    }

    .ob-proof :global(li:nth-child(odd)) {
      border-inline-start: 0;
    }

    .ob-proof :global(li:last-child) {
      grid-column: 1 / -1;
    }
  }
</style>
