---
/* The landing page's section shell: a rail on the left carrying the label, the
 * heading and one sentence, and whatever the section is actually showing on the
 * right.
 *
 * The one-column version this replaced capped its prose at a reading measure
 * inside a much wider container, so every section left roughly forty percent of
 * the page empty on the right and stacked text on the left. The rail fixes that
 * and does something the copy edit could not: it is narrow, so a section that
 * wants three paragraphs of lede no longer fits one.
 *
 * Only the eyebrow is a prop. The heading and the sentence are authored as
 * Markdown in the slot, because the site serves every page as clean Markdown at
 * `<path>.md` and `toPlainMarkdown` strips component tags — copy passed as a
 * prop would render for a person and vanish for an agent.
 *
 * The slot is expected to hold, in order: an `## h2`, one paragraph, and one
 * element that is the figure. Placement below names those three positions; a
 * second paragraph would land in the rail, which is the intended pressure.
 */
interface Props {
  eyebrow: string;
}

const { eyebrow } = Astro.props;
---

<section class="ob-sec">
  <p class="ob-eyebrow">{eyebrow}</p>
  <slot />
</section>

<style>
  /* Symmetric padding. The previous version had 3rem on top and none beneath,
     so the rule that opens each section sat flush on the figure above it while
     all the air went below — the gap was 0 above and 48px under. */
  .ob-sec {
    border-top: 1px solid var(--sl-color-gray-5);
    padding: 3.5rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 3rem;
  }

  .ob-eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin: 0;
  }

  .ob-sec :global(> .sl-heading-wrapper) {
    margin: 0;
    max-width: 30rem;
    text-wrap: balance;
  }

  .ob-sec :global(> .sl-heading-wrapper h2) {
    font-size: clamp(1.3rem, 2.2vw, 1.55rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .ob-sec :global(> .sl-heading-wrapper + p) {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.75;
    color: var(--sl-color-gray-3);
  }

  .ob-sec :global(> .sl-heading-wrapper + p code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--sl-color-gray-2);
  }

  .ob-sec :global(> [data-ob-figure]) {
    margin: 0;
  }

  /* The rail. Below this width everything stacks in source order, which is
     already the right order. */
  @media (min-width: 56rem) {
    .ob-sec {
      grid-template-columns: 18.5rem minmax(0, 1fr);
      /* The three rail rows are content-sized and the fourth absorbs whatever
         the figure is taller by. Without this the figure's row span stretched
         every row equally and the heading drifted down the page — halfway down,
         in the section whose figure is tallest. */
      grid-template-rows: auto auto auto 1fr;
      row-gap: 0.85rem;
    }

    .ob-sec > .ob-eyebrow {
      grid-area: 1 / 1;
    }

    .ob-sec :global(> .sl-heading-wrapper) {
      grid-area: 2 / 1;
    }

    .ob-sec :global(> .sl-heading-wrapper + p) {
      grid-area: 3 / 1;
    }

    /* The figure takes the second column and every row the rail occupies. It is
       addressed by `data-ob-figure` rather than `:last-child` because Astro
       leaves a component's inline script as the section's final element — a
       zero-height node that quietly won the placement and left the real figure
       to auto-flow. */
    .ob-sec :global(> [data-ob-figure]) {
      grid-area: 1 / 2 / 5 / 3;
    }
  }
</style>
